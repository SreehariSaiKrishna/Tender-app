# ============================================================
# Tender Intelligence Agent - environment configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file. NEVER put passwords/OTPs
# for TenderDetail in this file or anywhere in source control.
# ============================================================

# --- TenderDetail account ---
# Only the login/account identifier goes here (e.g. your email/username).
# The password is NEVER stored here. On first run, the collector opens a
# real, visible browser window and you log in manually (including any OTP).
# The authenticated session is then persisted in a local Playwright browser
# profile (see TENDERDETAIL_PROFILE_DIR) so you don't have to log in every time.
TENDERDETAIL_BASE_URL=https://www.tenderdetail.com
TENDERDETAIL_LOGIN_URL=https://www.tenderdetail.com/registeruser/dashboard
TENDERDETAIL_USERNAME=

# OPTIONAL - only set this if you've deliberately chosen auto-fill login
# over manual login (see README "Login flow" section for the tradeoff).
# If set, the collector types this into the password field for you. It is
# stored here in PLAINTEXT on your local disk. Never commit this file.
# Leave blank to keep typing your password manually (default, safer).
TENDERDETAIL_PASSWORD=

# Directory for the persistent Playwright browser profile (cookies/session).
# This directory is gitignored and must never be committed or shared.
TENDERDETAIL_PROFILE_DIR=./data/browser_profile

# Run browser headless once you've verified everything works manually.
# Keep this "false" until Phase 2/3 have been verified.
BROWSER_HEADLESS=false

# --- Database ---
DATABASE_URL=sqlite:///./data/database/tenders.db

# --- AI screening provider ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RELEVANCE_THRESHOLD=60

# --- SMTP / Email report ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=

# --- App behaviour ---
LOG_LEVEL=INFO
DOWNLOAD_DIR=./data/raw
PROCESSED_DIR=./data/processed
