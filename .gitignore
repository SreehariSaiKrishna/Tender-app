# Secrets / local config
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Browser automation state (session cookies, auth) - NEVER commit
data/browser_profile*/
**/browser_profile*/
playwright-report/
test-results/

# Data (private downloads, processed exports) - the database itself is
# MongoDB Atlas now, nothing local to ignore for it.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# AWS SAM - build artifacts and per-machine local secrets, never commit.
# samconfig.toml itself is tracked - it holds no secrets, just deploy
# config (stack name, region, capabilities).
.aws-sam/
env.json

# Tender documents downloaded at runtime by the document collector
data/documents/
