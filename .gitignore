# Secrets / local config
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Browser automation state (session cookies, auth) - NEVER commit
data/browser_profile*/
**/browser_profile*/
playwright-report/
test-results/

# Data (private downloads, processed exports, DB)
data/raw/*
data/processed/*
data/database/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/database/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
